{
  "name": "resource-verification-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "Resource Verification MVP monorepo",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:api": "pnpm --filter @resource-verification/api dev",
    "dev:web": "pnpm --filter @resource-verification/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @resource-verification/database db:migrate",
    "db:seed": "pnpm --filter @resource-verification/database db:seed",
    "db:generate": "pnpm --filter @resource-verification/database db:generate",
    "demo:reset": "pnpm --filter @resource-verification/database demo:reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  }
}
